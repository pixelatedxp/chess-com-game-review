{
  "manifest_version": 3,
  "name": "pixel's game review",
  "description": "Review finished Chess.com games with local analysis and an interactive board.",
  "version": "1.1.0",
  "icons": {"16": "icons/pawn-16.png", "48": "icons/pawn-48.png", "128": "icons/pawn-128.png"},
  "action": {"default_title": "pixel's game review", "default_icon": {"16": "icons/pawn-16.png", "48": "icons/pawn-48.png", "128": "icons/pawn-128.png"}},
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.chess.com/*", "https://*.chess.com/*", "https://assets-themes.chess.com/*", "https://images.chesscomfiles.com/*", "https://api.chess.com/*"],
  "background": {"service_worker": "background.js"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"},
  "content_scripts": [
    {"matches": ["https://www.chess.com/*", "https://chess.com/*"], "run_at": "document_start", "world": "MAIN", "js": ["page-context.js"]},
    {"matches": ["https://www.chess.com/*", "https://chess.com/*"], "run_at": "document_idle", "js": ["content.js"]}
  ]
}
